# Copia este archivo como .env en esta misma carpeta (dockerizacion/) y cambia las claves.
# El .env esta en .gitignore: nunca se sube al repo.
# Si no existe .env, el compose usa los valores por defecto (guest/guest y var_enabled).

RABBITMQ_USER=varenabled
RABBITMQ_PASSWORD=CambiaEstaClave1

POSTGRES_DB=var_enabled
POSTGRES_USER=var_enabled
POSTGRES_PASSWORD=CambiaEstaClave2

# Segundos reales que dura un minuto de partido (60 = tiempo real). Para ensayar rapido: 2
# PARTIDO_SEGUNDOS_POR_MINUTO=60
