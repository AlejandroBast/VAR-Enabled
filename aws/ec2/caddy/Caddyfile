# Puerta de entrada de VAR-Enabled en la EC2.
# Caddy corre en su propio contenedor, fuera del docker-compose del proyecto, con
# --network host. Saca y renueva solo los certificados HTTPS (Let's Encrypt).
#
# Las variables se crean a mano en la EC2, en /etc/var-enabled/caddy.env
# (ver docs/DESPLIEGUE_AWS.md):
#   SITIOS          dominio de la app, por ejemplo "var-enabled-ucc.duckdns.org"
#   SITIO_RABBITMQ  dominio del panel, por ejemplo "rabbit.var-enabled-ucc.duckdns.org"
#   HASH_OPERADOR   hash bcrypt de la clave del usuario "operador"

# Cabeceras de seguridad que se usan en los dos sitios
(seguridad) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$SITIOS} {
	import seguridad

	# EventMaker y la API de eventos cambian los partidos: piden usuario y clave.
	# El marcador y su WebSocket son publicos porque solo se leen.
	@operador path /eventmaker /eventmaker/* /api/*
	basic_auth @operador {
		operador {$HASH_OPERADOR}
	}

	redir /eventmaker /eventmaker/

	# WebSocket del marcador en vivo (dashboard_backend)
	handle /marcador {
		reverse_proxy 127.0.0.1:8081
	}

	# API para crear partidos y disparar eventos (live_feed_producer)
	handle /api/* {
		reverse_proxy 127.0.0.1:8082
	}

	# EventMaker, el HTML para probar el flujo del VAR a mano
	handle_path /eventmaker/* {
		root * /srv/eventmaker
		encode zstd gzip
		file_server
	}

	# Frontend de Angular (build de produccion)
	handle {
		root * /srv/frontend
		encode zstd gzip
		try_files {path} /index.html
		file_server
	}
}

# Panel de RabbitMQ: solo por HTTPS y con el login propio de RabbitMQ
# (usuario y clave del .env). No lleva basic_auth porque el panel usa la misma
# cabecera Authorization para su login y las dos claves chocan.
{$SITIO_RABBITMQ} {
	import seguridad
	reverse_proxy 127.0.0.1:15672
}
